#
# 部署说明：这些是 user 级 systemd 单元（放在 ~/.config/systemd/user/）。
#   1. 按你的实际路径修改 ExecStart / WorkingDirectory
#   2. systemctl --user daemon-reload
#   3. systemctl --user enable --now <unit>
#   4. loginctl enable-linger $USER   # 让用户服务在未登录时也运行
#
# 主要路径默认按 /root/... 写，部署到别处请整体替换。

[Unit]
Description=MiniMax Daily Check-in

[Service]
Type=oneshot
WorkingDirectory=/root/relay
ExecStart=/usr/bin/node /root/relay/minimax-checkin.mjs
StandardOutput=append:/root/relay/minimax-checkin.log
StandardError=append:/root/relay/minimax-checkin.log
