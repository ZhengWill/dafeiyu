#
# 部署说明：这些是 user 级 systemd 单元（放在 ~/.config/systemd/user/）。
#   1. 按你的实际路径修改 ExecStart / WorkingDirectory
#   2. systemctl --user daemon-reload
#   3. systemctl --user enable --now <unit>
#   4. loginctl enable-linger $USER   # 让用户服务在未登录时也运行
#
# 主要路径默认按 /root/... 写，部署到别处请整体替换。

[Unit]
Description=Sync relay usage to AstrBot data dir
After=relay.service

[Service]
Type=simple
# 每分钟把中转站状态压成插件可读的精简 JSON（#白饭 指令依赖它）
ExecStart=/bin/bash -c 'while true; do /usr/bin/python3 /root/sync_relay_usage.py; sleep 60; done'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
